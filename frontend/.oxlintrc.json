{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "nextjs",
    "jsx-a11y",
    "import"
  ],
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".next/**",
    "build/**",
    "coverage/**",
    "src/utils/api.ts",
    "src/utils/api.schemas.ts"
  ],
  "rules": {
    "react/jsx-curly-brace-presence": [
      "warn",
      {
        "props": "never",
        "children": "never"
      }
    ],
    "react/rules-of-hooks": "warn",
    "react/exhaustive-deps": "warn"
  }
}
