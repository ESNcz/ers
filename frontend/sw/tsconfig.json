  "compilerOptions": {
    "target": "ES2020",
    "lib": ["esnext", "webworker"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "../public",
    "removeComments": true,
    "newLine": "lf"
  },
  "files": ["sw.ts"]
}
