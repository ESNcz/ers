{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:sw && next dev",
    "devHttps": "pnpm build:sw && next dev --experimental-https",
    "startHttps": "pnpm build:sw && next dev --experimental-https",
    "inspect": "pnpm build:sw && NODE_OPTIONS='--inspect' next dev",
    "build": "pnpm build:sw && next build",
    "build:sw": "tsc -p sw",
    "dev:sw": "tsc -p sw --watch",
    "start": "next start",
    "test": "oxfmt --check src sw",
    "format": "oxfmt src sw",
    "generateTypes": "pnpm orval",
    "lint": "oxlint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/dropzone": "^9.7.1",
    "@mantine/form": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@mantine/tiptap": "^9.7.1",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/extension-character-count": "^3.13.0",
    "@tiptap/extension-color": "^3.13.0",
    "@tiptap/extension-highlight": "^3.13.0",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-link": "^3.13.0",
    "@tiptap/extension-subscript": "^3.13.0",
    "@tiptap/extension-superscript": "^3.13.0",
    "@tiptap/extension-text-align": "^3.13.0",
    "@tiptap/extension-text-style": "^3.13.0",
    "@tiptap/extension-underline": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "axios": "^1.21.0",
    "country-list-with-dial-code-and-flag": "^5.1.1",
    "dayjs": "^1.11.19",
    "jose": "^6.1.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone-esm": "^15.2.0",
    "react-easy-crop": "^5.5.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cookies-next": "^6.1.1",
    "orval": "^8.46.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3"
  }
}
